extends ./layout/layout-default
block content
  .SiteHero
    .HeroCopy
      .HeroMasthead
        img(src='./game/assets/img/hire-and-seek-logo.png' alt='' width='76' height='76')
        p.Eyebrow WELCOME TO ORBIT WORKS
      h1 Hire &amp; Seek
      p.Tagline You hire. It learns.
      p.Intro A new job. A stack of CVs. A machine that learns from you. What could go wrong?
      a.MainButton(href='./game/') Start your shift →
      p.SmallNote No code. Just choices.
    .HeroBoard(aria-label='An illustrated hiring desk')
      .BoardHead ORBIT WORKS / PEOPLE TEAM
      .BoardScreen
        .BoardEyes
          i
          i
        span SCOUT
      .BoardFile
        span APPLICANT FILE
        strong Your next hire?
        .BoardLine
        .BoardLine
        p Bengaluru / Chennai
      .BoardTable
      span.BoardStamp OPEN FOR HIRING
      p.BoardLabel A little help. A lot to learn.
  section.HowSection(aria-labelledby='how-heading')
    p.Eyebrow YOUR FIRST SHIFT
    h2#how-heading Take the desk. Then look closer.
    .HowGrid
      article
        span.StepNumber 01
        h3 Read the CVs
        p Meet the applicants. Choose who to hire.
      article
        span.StepNumber 02
        h3 Meet Scout
        p Give it examples. Watch the choices it makes.
      article
        span.StepNumber 03
        h3 Ask better questions
        p Check the records. Look for patterns you missed.
