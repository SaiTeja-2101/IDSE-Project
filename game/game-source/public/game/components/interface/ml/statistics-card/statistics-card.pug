mixin stats(title)
    div.StatisticsCard&attributes(attributes)
        div.FlexContainer
            div.HiredMakeup
                p.stats-category__name Accepted share: Bengaluru / Chennai
                div.stats-category__skillbar
                    div.stats-category__progress
            div.RejectedMakeup
                p.stats-category__name Rejected share: Bengaluru / Chennai
                div.stats-category__skillbar
                    div.stats-category__progress
            
        div.FlexContainer
            div.AverageOrange
                p.stats-category__name Average CV score: Bengaluru
                div.stats-category__skillbar
                    div.stats-category__progress
            div.AverageBlue
                p.stats-category__name Average CV score: Chennai
                div.stats-category__skillbar
                    div.stats-category__progress
