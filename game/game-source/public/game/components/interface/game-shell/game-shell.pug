header.GameBar
  a.GameBrand(href='../' aria-label='Hire and Seek home')
    img.BrandIcon(src='./assets/img/hire-and-seek-logo.png' alt='' width='48' height='48')
    span Hire & Seek
  .ChapterInfo
    strong#chapter-name Your first day
  .GameControls
    button#pause-game(type='button' aria-haspopup='dialog') Pause
    button#sound-game(type='button' aria-pressed='false') Sound on
aside.ScoutPanel(aria-label='Scout status')
  .ScoutFace(aria-hidden='true')
    span
    span
  div
    strong SCOUT
    p#scout-status Waiting for your first hires
.OfficeLabel(aria-hidden='true') ORBIT WORKS / PEOPLE TEAM
.CityKey(aria-label='Applicant cities')
  span
    i.CityDot.CityDot--orange
    | Bengaluru
  span
    i.CityDot.CityDot--blue
    | Chennai
.OfficeHint Choose a person in the queue to read their CV.
section#pause-dialog.PauseScreen(hidden role='dialog' aria-modal='true' aria-labelledby='pause-title')
  .PauseCard
    span.SmallLabel TAKE A BREATHER
    h1#pause-title Game paused
    p Your place is saved while this page stays open.
    button#resume-game(type='button') Back to the game
    p.PauseHint Press Esc to pause or return.
